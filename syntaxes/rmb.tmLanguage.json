{
	"$schema": "../schema/tmlanguage.json",
	"name": "rmb",
	"patterns": [
		{ "include": "#keywords" },
		{ "include": "#strings" },
		{ "include": "#comments" },
		{ "include": "#numbers"}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.rmb",
					"match": "\\b(if|while|for|return)\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.rmb",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.rmb",
					"match": "\\\\."
				}
			]
		},
		"comments": {
			"patterns": [
				{
					"name": "comment.line.exclamation.rmb",
					"match": "!.*$"
				}
			]
		},
		"numbers": {
			"patterns": [{
				"name": "constant.numeric.rmb",
				"match": "\\b[0-9]+(\\.[0-9]+)?\\b"
			}]
		}
	},
	"scopeName": "source.rmb"
}