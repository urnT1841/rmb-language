{
  "name": "rmb-syntax",
  "displayName": "RMB Syntax",
  "description": "Syntax highlighting for RMB language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rmb",
        "aliases": [
          "HP-Basic RMB",
          "rmb"
        ],
        "extensions": [
          ".rmb",
          ".bas",
          ".asc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rmb",
        "scopeName": "source.rmb",
        "path": "./syntaxes/rmb.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "rmb",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}