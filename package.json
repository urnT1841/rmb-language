{
  "name": "rmb-syntax",
  "displayName": "RMB Syntax",
  "description": "Syntax highlightitng for RMB language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "rmb",
      "aliases": ["rmb", "rmb"],
      "extensions": [".rmb"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "rmb",
      "scopeName": "source.rmb",
      "path": "./syntaxes/rmd.tmLanguage.json"
    }]
  }
}
